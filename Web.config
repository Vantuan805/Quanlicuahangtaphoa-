<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection" 
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=QuanLiCuaHangTapHoa;Integrated Security=True;MultipleActiveResultSets=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" requestValidationMode="2.0" />
    <pages enableEventValidation="false" viewStateEncryptionMode="Never">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Linq" />
        <add namespace="QuanLiCuaHangTapHoa.Models" />
        <add namespace="QuanLiCuaHangTapHoa.DAL" />
      </namespaces>
    </pages>
    <globalization culture="vi-VN" uiCulture="vi-VN" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="Off" />
    <httpModules>
      <remove name="ApplicationInsightsWebTracking" />
      <remove name="TelemetryHttpModule" />
    </httpModules>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="ApplicationInsightsWebTracking" />
      <remove name="TelemetryHttpModule" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
